// ============================================================
// 데이터베이스 설계도 (Prisma 스키마)
//
// [비개발자 설명]
// 회원·기사 정보를 어떤 항목으로 저장할지 적어둔 표의 설계도입니다.
// 여기를 고친 뒤 `npm run db:push` 를 실행하면
// 실제 데이터베이스의 표 구조가 이 내용대로 맞춰집니다.
//
// 항목을 지우거나 이름을 바꾸면 기존 데이터가 사라질 수 있으니
// 운영 중인 사이트에서는 반드시 백업 후 진행하세요.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====================================
// 사용자 역할 (권한 구분)
// ====================================
enum Role {
  USER    // 일반 회원 (기사 읽기만 가능)
  WRITER  // 기자 계정용으로 미리 만들어 둔 등급. 현재 권한은 USER와 동일합니다.
  ADMIN   // 관리자 (기사 작성·수정·삭제, 이미지 업로드 가능)
}

// ====================================
// 기사 카테고리
// ====================================
enum Category {
  POLITICS  // 정치
  ECONOMY   // 경제
  SOCIETY   // 사회
  CULTURE   // 생활/문화
  TECH      // IT/과학
  WORLD     // 세계
}

// ====================================
// 기사 상태
// ====================================
enum Status {
  DRAFT      // 임시저장
  PUBLISHED  // 발행
}

// ====================================
// 사용자 테이블
// ====================================
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique              // 이메일 (로그인 ID)
  password      String                         // bcrypt로 해시된 비밀번호
  name          String                         // 표시 이름
  role          Role      @default(USER)       // 권한 (기본: 일반 회원)
  emailVerified Boolean   @default(false)      // 이메일 인증 여부
  createdAt     DateTime  @default(now())      // 가입일
  updatedAt     DateTime  @updatedAt           // 수정일

  // 작성한 기사들
  articles      Article[]
  // 이메일 인증 토큰들
  verificationTokens VerificationToken[]
  // 비밀번호 재설정 토큰들
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// ====================================
// 이메일 인증 토큰 테이블
// 회원가입 시 6자리 코드 발급 → 인증 완료 시 삭제
// ====================================
model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique            // 6자리 인증 코드
  userId    Int                         // 대상 사용자
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime                    // 만료 시각 (발급 후 10분)
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

// ====================================
// 비밀번호 재설정 토큰 테이블
// ====================================
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique            // 랜덤 UUID 토큰
  userId    Int                         // 대상 사용자
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime                    // 만료 시각 (발급 후 30분)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ====================================
// 기사 테이블
// ====================================
model Article {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(500)   // 기사 제목
  content     String    @db.LongText       // 기사 본문
  summary     String?   @db.Text           // 요약 (선택, 목록에 표시)
  thumbnail   String?                      // 썸네일 이미지 경로
  category    Category                     // 카테고리
  status      Status    @default(DRAFT)    // 발행 상태
  views       Int       @default(0)        // 조회수

  // 작성자 관계
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())    // 작성일
  updatedAt   DateTime  @updatedAt         // 수정일

  @@map("articles")
}
