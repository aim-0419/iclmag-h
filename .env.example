# ============================================================
# 환경변수 예시 파일
#
# [사용 방법]
#   1) 이 파일을 복사해 .env.local 이라는 이름으로 저장합니다.
#   2) 아래 값들을 실제 정보로 바꿉니다.
#   3) .env.local 은 비밀 정보라 git 에 올라가지 않습니다. (.gitignore 처리됨)
#
# ※ DATABASE_URL 은 Prisma 도구가 .env 파일에서도 읽으므로
#    .env 와 .env.local 두 곳 모두에 넣어두는 것을 권장합니다.
# ============================================================

# ------------------------------------------------------------
# 데이터베이스 (MySQL)
# 형식: mysql://아이디:비밀번호@주소:포트/DB이름
# ------------------------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/iclmag"

# ------------------------------------------------------------
# 로그인 출입증(JWT) 설정
# ------------------------------------------------------------
# 출입증 서명에 쓰는 비밀 열쇠. 아무도 모르는 32자 이상 무작위 문자열을 넣으세요.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# 출입증 유효기간 (7d=7일, 24h=24시간, 60m=60분)
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------
# 사이트 주소
# ------------------------------------------------------------
# 비밀번호 재설정 메일의 링크와 쿠키 보안 설정에 사용됩니다.
# 실제 서비스에서는 https 주소를 넣어야 쿠키 보안(secure)이 켜집니다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ICLMAG"

# ------------------------------------------------------------
# 이메일 발송 (Gmail SMTP)
#
# Gmail 은 계정 비밀번호가 아니라 "앱 비밀번호"를 사용해야 합니다.
#   Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호 발급
# 이 값이 없으면 회원가입 인증 코드와 비밀번호 재설정 메일이 발송되지 않습니다.
# ------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_USER="보내는사람@gmail.com"
EMAIL_PASS="앱 비밀번호 16자리"
EMAIL_FROM="이끌림필라테스매거진 <보내는사람@gmail.com>"
